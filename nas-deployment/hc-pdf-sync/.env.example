# TerraMaster NAS HC-PDF Sync Worker Environment Configuration
# Copy this file to .env on the NAS host in /Volume3/docker/hc-pdf-sync/.env
# Replace your_tnas_api_key_here with the actual secret matching Railway

TNAS_API_KEY=your_tnas_api_key_here
SAAS_API_BASE_URL=https://haptrans-production.up.railway.app
TARGET_DIR=/hc-pdf
RECEIPTS_DIR=/receipts
SYNC_INTERVAL_MS=2500
NODE_ENV=production
