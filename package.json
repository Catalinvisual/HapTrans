{
  "name": "hapcargo-tms",
  "version": "0.1.0",
  "private": true,
  "description": "HAP CARGO TMS — Production-grade European Transport Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,prisma}\"",
    "db:generate": "npm run -w @hapcargo/database db:generate",
    "db:migrate": "npm run -w @hapcargo/database db:migrate",
    "db:deploy": "npm run -w @hapcargo/database db:deploy",
    "db:seed": "npm run -w @hapcargo/database db:seed",
    "db:studio": "npm run -w @hapcargo/database db:studio",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/speakeasy": "^2.0.10",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "speakeasy": "^2.0.0",
    "tsx": "^4.23.13"
  }
}
