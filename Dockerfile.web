# HAP CARGO WEB — deploy on Railway with Builder: DOCKERFILE (Root Directory: /)
# Service setting: Dockerfile Path = "Dockerfile.web"
# Next.js standalone output is copied to the runtime image and served directly.

FROM node:22-alpine AS builder
WORKDIR /app

COPY . .
RUN npm ci \
  && npm run build -w @hapcargo/web

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

COPY --from=builder /app/apps/web/.next/standalone/apps/web ./
COPY --from=builder /app/apps/web/.next/static ./.next/static

EXPOSE 3000
ENV PORT=3000
CMD ["node", "server.js"]