{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ../.. && npm install && npm run build -w @hapcargo/web"
  },
  "deploy": {
    "startCommand": "cp -r .next/static .next/standalone/apps/web/.next/static && node .next/standalone/apps/web/server.js",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "watchPatterns": [
      "apps/web/**",
      "packages/ui/**",
      "packages/shared/**",
      "package.json",
      "package-lock.json"
    ]
  }
}