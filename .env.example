# HAP CARGO TMS — environment template
# Copy to .env and fill real values. NEVER commit real secrets.

# API
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:Laptophp20242019.@localhost:5432/Hapcargo?schema=public

# Redis (cache / queue / rate-limit)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO local / S3-compatible prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hapcargo
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret

# Auth — generate strong values locally, keep secret in production
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# i18n
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=ro,en,nl,pl,fr,es
